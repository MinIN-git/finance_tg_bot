# Токен бота от @BotFather
BOT_TOKEN=

# Telegram user_id, которым бот отвечает (через запятую). Узнать свой: @userinfobot
ALLOWED_USER_IDS=123456789

# ID Google-таблицы: часть ссылки между /d/ и /edit
SPREADSHEET_ID=

# Путь к JSON-ключу service account (в Docker переопределяется на /app/secrets/service_account.json)
GOOGLE_CREDENTIALS_FILE=secrets/service_account.json

# Символ валюты в отчетах, например ₽ или €. Пусто — без символа.
CURRENCY=

# Часовой пояс для дат, «вчера» и отчета 1 числа
TIMEZONE=Europe/Moscow

# Во сколько (час, по TIMEZONE) 1 числа присылать отчет и опрос остатков
REPORT_HOUR=10

# Сколько секунд кэшировать операции из таблицы (ручные правки подтянутся через это время или по /refresh)
CACHE_TTL=300

# sheets — Google Sheets; memory — в памяти, для пробного запуска без таблицы (данные не сохраняются)
STORAGE=sheets
